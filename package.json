{
  "name": "@pavel-agarkov/skills",
  "version": "0.5.1",
  "description": "Install selected AI agent skills into a project by name or tag.",
  "type": "module",
  "bin": {
    "skills": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/skills/",
    "README.md",
    "changelog.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-agarkov/skills.git"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc",
    "build": "node scripts/build.ts",
    "pretest": "npm run typecheck && npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "changelog": "node scripts/changelog.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
